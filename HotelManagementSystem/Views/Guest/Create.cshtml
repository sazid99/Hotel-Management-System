@model HotelManagementSystem.Models.Guest

<div class="container mt-4">
    <h2>Create Guest Profile</h2>
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" type="email" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Phone</label>
            <input asp-for="Phone" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">NID / Passport Number</label>
            <input asp-for="IdentityDocumentNumber" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Preferences / Special Notes</label>
            <textarea asp-for="Preferences" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-success">Save Guest</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>