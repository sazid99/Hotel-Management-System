@model IEnumerable<HotelManagementSystem.Models.Guest>

<div class="container mt-4">
    <h2>Guest List</h2>
    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-primary">Add New Guest</a>
        <form method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search by name/phone..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
        </form>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>