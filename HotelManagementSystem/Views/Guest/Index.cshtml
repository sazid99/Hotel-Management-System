@model IEnumerable<HotelManagementSystem.Models.Guest>

@{
    ViewData["Title"] = "Guest List";
}

<div class="container mt-4">
    <h2>Guest List</h2>

    <div class="d-flex justify-content-between mb-3">
        <a asp-action="Create" class="btn btn-primary">Add New Guest</a>
        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search by name/phone/email..." />
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </form>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Document</th>
                <th>Preferences</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Phone</td>
                    <td>@item.IdentityDocumentType - @item.IdentityDocumentNumber</td>
                    <td>@item.Preferences</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline"
                              onsubmit="return confirm('Are you sure you want to delete this guest?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>