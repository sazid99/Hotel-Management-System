@model HotelManagementSystem.Models.Guest

@{
    ViewData["Title"] = "Edit Guest";
}

<h2>Edit Guest</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div class="mb-2">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label>Address</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Identity Document Type</label>
        <select asp-for="IdentityDocumentType" class="form-control">
            <option value="">-- Select --</option>
            <option value="NID">NID</option>
            <option value="Passport">Passport</option>
            <option value="Driving License">Driving License</option>
        </select>
    </div>

    <div class="mb-2">
        <label>Identity Document Number</label>
        <input asp-for="IdentityDocumentNumber" class="form-control" />
    </div>

    <div class="mb-2">
        <label>Preferences / Special Notes</label>
        <textarea asp-for="Preferences" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Update Guest</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>