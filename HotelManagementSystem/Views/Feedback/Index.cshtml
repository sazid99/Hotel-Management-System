@model IEnumerable<HotelManagementSystem.Models.Feedback>

@{
    ViewData["Title"] = "Guest Feedbacks";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-comments text-primary me-2"></i>Guest Feedbacks
            </h2>
            <p class="text-muted small mb-0">Manage and review all customer comments, ratings, and feedback submissions.
            </p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> Add Feedback
            </a>
        </div>
    </div>

    <!-- Feedback Table / Content Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th class="ps-4">Guest Name</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <div>@item.GuestName</div>
                                        <div class="text-muted small">@item.Email</div>
                                    </td>
                                    <td>
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.Rating)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                            <span class="text-muted ms-1">(@item.Rating/5)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate text-secondary" style="max-width: 250px;"
                                              title="@item.Comments">
                                            @item.Comments
                                        </span>
                                    </td>
                                    <td class="text-muted small">@item.DateSubmitted.ToString("MMM dd, yyyy")</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary"
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary"
                                               title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger"
                                               title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No feedback found. Click "Add Feedback" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>