@model HotelManagementSystem.Models.Feedback

@{
    ViewData["Title"] = "Respond to Feedback";
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <h2 class="fw-bold text-dark mb-1">
                <i class="fas fa-reply text-primary me-2"></i>Respond to Feedback
            </h2>
            <p class="text-muted small mb-0">Review guest feedback and send a professional response via email.</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Original Feedback Details Card -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-light">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3"><i class="fas fa-info-circle text-secondary me-2"></i>Guest
                        Details</h5>
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-semibold text-muted">Guest Name:</div>
                            <div class="col-sm-8 text-dark fw-semibold">@Model.GuestName</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-semibold text-muted">Email Address:</div>
                            <div class="col-sm-8 text-dark">@Model.Email</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-sm-4 fw-semibold text-muted">Rating:</div>
                            <div class="col-sm-8 text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Model.Rating)
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                                <span class="text-muted ms-1">(@Model.Rating/5)</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4 fw-semibold text-muted">Comments:</div>
                            <div class="col-sm-8 text-secondary fst-italic">"@Model.Comments"</div>
                        </div>
                    </div>
                </div>

                <!-- Response Form Card -->
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <form asp-action="Respond" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Admin Response / Reply Message</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light align-items-start pt-2">
                                        <i class="fas fa-paper-plane text-muted"></i>
                                    </span>
                                    <textarea name="adminResponse" class="form-control" rows="5"
                                              placeholder="Write a polite response to the guest..." required></textarea>
                                </div>
                                <div class="form-text text-muted">This response will be saved and can be dispatched to the
                                    guest's email.</div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex justify-content-between align-items-center">
                                    <a asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-left me-1"></i> Back to List
                                    </a>
                                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                        <i class="fas fa-paper-plane me-1"></i> Send Response
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>