@model HotelManagementSystem.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container py-4">
    <!-- Action Buttons (Hidden when printing) -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i> Back to List
        </a>
        <button onclick="window.print()" class="btn btn-primary shadow-sm">
            <i class="fas fa-print me-1"></i> Print Invoice
        </button>
    </div>

    <!-- Invoice Card -->
    <div class="card border-0 shadow-sm rounded-3 p-4 p-md-5">
        <!-- Invoice Header -->
        <div class="row justify-content-between mb-4">
            <div class="col-sm-6">
                <h3 class="fw-bold text-primary mb-1">
                    <i class="fas fa-hotel me-2"></i>Hotel Management System
                </h3>
                <p class="text-muted small mb-0">123 Hotel Avenue, Luxury City</p>
                <p class="text-muted small mb-0">Email: support@hotelms.com | Phone: +1 234 567 890</p>
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h2 class="fw-bold text-dark">INVOICE</h2>
                <p class="text-muted mb-0">Invoice ID: <span class="fw-semibold text-dark">#@(Model?.Id > 0 ?
                                            Model.Id.ToString() : "101")</span></p>
                    <p class="text-muted mb-0">Date: <span
                        class="fw-semibold text-dark">@(Model?.IssueDate.ToString("yyyy-MM-dd") ??
                                                DateTime.Now.ToString("yyyy-MM-dd"))</span></p>
                    </div>
                </div>

                <hr class="my-4">

                <!-- Billing To Information -->
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <h6 class="fw-bold text-uppercase text-secondary mb-2">Invoiced To:</h6>
                        <p class="fw-semibold mb-1">Valued Guest</p>
                        <p class="text-muted small mb-0">Booking Reference ID: #@(Model?.BookingId > 0 ?
                                                Model.BookingId.ToString() : "15")</p>
                        </div>
                        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                            <h6 class="fw-bold text-uppercase text-secondary mb-2">Payment Status:</h6>
                            @if (Model?.Status == "Paid")
                            {
                                <span class="badge bg-success px-3 py-2 fs-6">Paid</span>
                            }
                            else if (Model?.Status == "Partially Paid")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6">Partially Paid</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2 fs-6">Unpaid</span>
                            }
                        </div>
                    </div>

                    <!-- Invoice Items Table -->
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Room Accommodation & Services (Booking ID: #@(Model?.BookingId ?? 15))</td>
                                    <td class="text-end">$@(Model?.TotalAmount > 0 ? Model.TotalAmount.ToString("0.00") : "350.00")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Totals -->
                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-semibold">Total Amount:</td>
                                    <td class="text-end">$@(Model?.TotalAmount > 0 ? Model.TotalAmount.ToString("0.00") : "350.00")
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold text-success">Paid Amount:</td>
                                    <td class="text-end text-success">$@(Model?.PaidAmount > 0 ? Model.PaidAmount.ToString("0.00") :
                                          "350.00")</td>
                                    </tr>
                                    <tr class="border-top">
                                        <td class="fw-bold fs-5">Due Amount:</td>
                                        <td class="text-end fw-bold fs-5 text-danger">$@(Model?.DueAmount > 0 ?
                                                                        Model.DueAmount.ToString("0.00") : "0.00")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <hr class="my-4">

                            <!-- Footer Note -->
                            <div class="text-center text-muted small">
                                <p class="mb-0">Thank you for staying with us! We look forward to welcoming you again.</p>
                            </div>
                        </div>
                    </div>