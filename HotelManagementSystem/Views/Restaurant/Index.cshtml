@model List<HotelManagementSystem.Models.RestaurantOrder>

@{
    ViewData["Title"] = "Restaurant Orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Restaurant Orders</h2>
        <a asp-action="Order" class="btn btn-primary">+ New Order</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No orders found yet.</div>
    }
    else
    {
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Guest Name</th>
                    <th>Room No</th>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Order Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.GuestName</td>
                        <td>@order.RoomNumber</td>
                        <td>@order.ItemName</td>
                        <td>@order.Quantity</td>
                        <td>@order.Price.ToString("C")</td>
                        <td>@order.TotalPrice.ToString("C")</td>
                        <td>@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                        <td>
                            <span
                                class="badge bg-@(order.Status == HotelManagementSystem.Models.OrderStatus.Served ? "success" : order.Status == HotelManagementSystem.Models.OrderStatus.Cancelled ? "danger" : "warning")">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@order.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>