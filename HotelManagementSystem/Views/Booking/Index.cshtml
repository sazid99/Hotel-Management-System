@model IEnumerable<HotelManagementSystem.Models.Booking>

@{
    ViewData["Title"] = "Booking History";
}

<div class="container mt-4">
    <h2>Booking History</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <a asp-action="Search" class="btn btn-primary">
            <i class="fas fa-search me-1"></i> Search Rooms / New Booking
        </a>

        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input type="text" name="guestSearch" value="@ViewBag.GuestSearch" class="form-control" placeholder="Search by guest name..." />
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">Pending</option>
                <option value="Confirmed" selected="@(ViewBag.StatusFilter == "Confirmed")">Confirmed</option>
                <option value="Modified" selected="@(ViewBag.StatusFilter == "Modified")">Modified</option>
                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled</option>
            </select>
            <button type="submit" class="btn btn-outline-secondary">Filter</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </form>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Guest</th>
                <th>Room</th>
                <th>Check-In</th>
                <th>Check-Out</th>
                <th>Nights</th>
                <th>Total</th>
                <th>Advance Paid</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@(b.Guest?.Name ?? "—")</td>
                    <td>@(b.Room != null ? $"{b.Room.RoomNumber} ({b.Room.Category})" : "—")</td>
                    <td>@b.CheckInDate.ToString("dd MMM yyyy")</td>
                    <td>@b.CheckOutDate.ToString("dd MMM yyyy")</td>
                    <td>@b.Nights</td>
                    <td>@b.TotalPrice.ToString("C0")</td>
                    <td>@b.AdvancePayment.ToString("C0")</td>
                    <td>
                        @{
                            var badgeClass = b.Status switch
                            {
                                "Confirmed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Cancelled" => "bg-danger",
                                "Modified" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@b.Status</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">No bookings found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
