@model IEnumerable<HotelManagementSystem.Models.Staff>

@{
    ViewData["Title"] = "Staff List";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4 align-items-center">
        <div class="col-sm-6">
            <h2 class="fw-bold text-dark mb-0">
                <i class="fas fa-users text-primary me-2"></i>Staff Directory
            </h2>
            <p class="text-muted small mb-0">Manage hotel staff members, roles, and contact details.</p>
        </div>
        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="fas fa-user-plus me-1"></i> Add New Staff
            </a>
        </div>
    </div>

    <!-- Staff Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Role / Position</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 text-primary me-3 text-center"
                                                 style="width: 38px; height: 38px;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <div>@item.Name</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span
                                            class="badge @(item.Role == "Manager" ? "bg-secondary" : item.Role == "Receptionist" ? "bg-info text-dark" : "bg-warning text-dark")">
                                            @item.Role
                                        </span>
                                    </td>
                                    <td class="text-muted">@item.Email</td>
                                    <td class="text-muted">@item.Phone</td>
                                    <td>
                                        <span class="badge @(item.Status == "Active" ? "bg-success" : "bg-secondary")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"
                                               title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                               title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No staff members found. Click "Add New Staff" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>