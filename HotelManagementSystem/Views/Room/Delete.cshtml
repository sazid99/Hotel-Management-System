@model HotelManagementSystem.Models.Room

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">

    <h2>Delete Room</h2>

    <div class="alert alert-danger">

        Are you sure you want to delete this room?

    </div>


    <table class="table table-bordered">

        <tr>

            <th>Room Number</th>

            <td>
                @Model.RoomNumber
            </td>

        </tr>


        <tr>

            <th>Room Type</th>

            <td>
                @Model.RoomType
            </td>

        </tr>


        <tr>

            <th>Status</th>

            <td>
                @Model.Status
            </td>

        </tr>


        <tr>

            <th>Price Per Night</th>

            <td>
                ৳ @Model.PricePerNight
            </td>

        </tr>


        <tr>

            <th>Amenities</th>

            <td>
                @Model.Amenities
            </td>

        </tr>

    </table>


    <form asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               name="id"
               value="@Model.Id" />


        <button type="submit"
                class="btn btn-danger">

            Yes, Delete

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </form>

</div>